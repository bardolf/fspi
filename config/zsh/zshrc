export ZSH="$HOME/.oh-my-zsh"
export EDITOR=nvim
ZSH_THEME="robbyrussell"

plugins=(
  git
  zsh-syntax-highlighting
  zsh-autosuggestions
  azure
  dnf
  kubectl
  fzf
)

source $ZSH/oh-my-zsh.sh

# Prepend hostname to the prompt so terminals on different machines are easy to tell apart
PROMPT='%{$fg_bold[yellow]%}[%m]%{$reset_color%} '$PROMPT

# Optional: make suggestions visible
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'

# History
HISTSIZE=500000
SAVEHIST=500000

# Custom aliases
alias k=kubectl
alias open='xdg-open'
alias icat='kitten icat'

# Yazi: `y` wrapper that cd's the shell into Yazi's last CWD on exit
function y() {
       local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
       yazi "$@" --cwd-file="$tmp"
       if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
               builtin cd -- "$cwd"
       fi
       rm -f -- "$tmp"
}

# Print to the CETIN office printer the way I always want it: 2-sided short
# edge, 2 pages per sheet. Optional page range as the 2nd argument.
#   tiskni report.pdf          # whole document
#   tiskni report.pdf 1-46     # only pages 1-46
function tiskni() {
  local file="$1" range="${2:-}"
  if [[ -z "$file" ]]; then
    echo "usage: tiskni <file> [page-range, e.g. 1-46]" >&2
    return 1
  fi
  local opts=(-d cetin -o sides=two-sided-short-edge -o number-up=2)
  [[ -n "$range" ]] && opts+=(-o "page-ranges=$range")
  lp "${opts[@]}" "$file"
}
export PATH="$HOME/.local/bin:$PATH"
eval "$(zoxide init --cmd cd zsh)"
eval "$(mise activate zsh)"

