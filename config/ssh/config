# Klíče se zkoušejí v tomhle pořadí, ale přidá se jen ten, který na stroji
# opravdu leží — jinak OpenSSH při každém spojení hlásí "no such identity:
# ... No such file or directory". Match exec vrátí 0 jen když soubor existuje,
# takže stejný config funguje na stroji s ed25519 i na tom, kde je jen RSA.
# POZOR: globální IdentityFile nahrazuje výchozí seznam OpenSSH — když tu byl
# jen id_ed25519, na stroji bez něj přestala fungovat veškerá autentizace
# klíčem (včetně gitu na GitHub), protože id_rsa se už nezkusil.
Match exec "test -r %d/.ssh/id_ed25519"
	IdentityFile ~/.ssh/id_ed25519
Match exec "test -r %d/.ssh/id_rsa"
	IdentityFile ~/.ssh/id_rsa

# desktop: auto-routes — direct when on the home LAN (192.168.1.0/24) or when
# the home VPN (vpn-home.sh, wg-home) routes it, via `server` (skybit.cz) when
# away. The Match exec returns 0 (→ apply ProxyJump) only when this machine has
# NO 192.168.1.x/24 address and 192.168.1.10 does not go via wg-home.
Host desktop
	HostName 192.168.1.10
	User milan
Match originalhost desktop exec "! ip -4 -o addr show | grep -qE 'inet 192.168.1.[0-9]+/24' && ! ip route get 192.168.1.10 | grep -q 'dev wg-home'"
	ProxyJump server

# Explicit overrides, in case auto-detection ever guesses wrong:
Host desktop-direct
	HostName 192.168.1.10
	User milan
Host desktop-jump
	HostName 192.168.1.10
	User milan
	ProxyJump server

# server: doma (výchozí brána = LAN MAC MikroTiku) rovnou přes LAN, jinak přes
# veřejné skybit.cz (doma by to jelo hairpinem přes ~7 hopů). Match musí být
# PŘED Host server — v ssh_config platí první nastavená hodnota. Test MAC brány
# nic neposílá do sítě; ping na 192.168.1.11 by v cizí 192.168.1.0/24 síti
# čekal na timeout. Se zapnutou VPN domů (wg-home) taky rovnou na 192.168.1.11
# — přes veřejné skybit.cz se zbytečně počítají nová spojení do brute-force
# blacklistu MikroTiku (4/min → ban celé veřejné IP na den).
Match originalhost server exec "ip neigh show 192.168.1.1 | grep -qi 74:4d:28:f1:71:bf || ip route get 192.168.1.11 | grep -q 'dev wg-home'"
	HostName 192.168.1.11
# Stejný stroj pod oběma adresami → klíč se vždy ověřuje proti záznamu skybit.cz.
Host server
	HostName skybit.cz
	HostKeyAlias skybit.cz
	User milan
Host root@mig
        HostName celrtsd401.server.cetin
        User root
Host mig
        HostName celrtsd401.server.cetin
        User makaluapp
Host jump
        HostName celnijumpp401.server.cetin
        User mi077548
Host runner01
        Hostname celcrisprund401.server.cetin
        User root
Host runner02
        Hostname celcrisprund402.server.cetin
        User root

# Jedno TCP spojení na cíl, další ssh/scp/rsync/git jedou uvnitř něj. Domácí MikroTik
# dá IP na den do brute-blacklistu po 4 nových spojeních na port 22 za minutu a pak
# z ní zahazuje VŠECHNO (i HA a fotky) — 29. 10. 2026 na to stačila 4 běžná přihlášení
# za 41 s. %C = hash uživatel+host+port: krátká cesta a doma/venku (jiný HostName pro
# `server`) vlastní socket. ServerAlive: po uspání nebo výpadku wifi master do ~45 s
# umře, jinak by se nové session věšely na mrtvé spojení.
# Zavřít sdílené spojení ručně: ssh -O exit server
Host *
	ControlMaster auto
	ControlPath ~/.ssh/cm-%C
	ControlPersist 10m
	ServerAliveInterval 15
	ServerAliveCountMax 3
