# Klíče se zkoušejí v tomhle pořadí, ale přidá se jen ten, který na stroji
# opravdu leží — jinak OpenSSH při každém spojení hlásí "no such identity:
# ... No such file or directory". Match exec vrátí 0 jen když soubor existuje,
# takže stejný config funguje na stroji s ed25519 i na tom, kde je jen RSA.
# POZOR: globální IdentityFile nahrazuje výchozí seznam OpenSSH — když tu byl
# jen id_ed25519, na stroji bez něj přestala fungovat veškerá autentizace
# klíčem (včetně gitu na GitHub), protože id_rsa se už nezkusil.
Match exec "test -r %d/.ssh/id_ed25519"
	IdentityFile ~/.ssh/id_ed25519
Match exec "test -r %d/.ssh/id_rsa"
	IdentityFile ~/.ssh/id_rsa

# desktop: auto-routes — direct when on the home LAN (192.168.1.0/24),
# via `server` (skybit.cz) when away. The Match exec returns 0 (→ apply
# ProxyJump) only when this machine has NO 192.168.1.x/24 address.
Host desktop
	HostName 192.168.1.10
	User milan
Match originalhost desktop exec "! ip -4 -o addr show | grep -qE 'inet 192.168.1.[0-9]+/24'"
	ProxyJump server

# Explicit overrides, in case auto-detection ever guesses wrong:
Host desktop-direct
	HostName 192.168.1.10
	User milan
Host desktop-jump
	HostName 192.168.1.10
	User milan
	ProxyJump server

# server: doma (výchozí brána = LAN MAC MikroTiku) rovnou přes LAN, jinak přes
# veřejné skybit.cz (doma by to jelo hairpinem přes ~7 hopů). Match musí být
# PŘED Host server — v ssh_config platí první nastavená hodnota. Test MAC brány
# nic neposílá do sítě; ping na 192.168.1.11 by v cizí 192.168.1.0/24 síti
# čekal na timeout.
Match originalhost server exec "ip neigh show 192.168.1.1 | grep -qi 74:4d:28:f1:71:bf"
	HostName 192.168.1.11
# Stejný stroj pod oběma adresami → klíč se vždy ověřuje proti záznamu skybit.cz.
Host server
	HostName skybit.cz
	HostKeyAlias skybit.cz
	User milan
Host root@mig
