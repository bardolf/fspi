# Font (mirrors wezterm: CaskaydiaMono Nerd Font Mono, DemiLight, size 12)
font-family = CaskaydiaMono Nerd Font Mono
font-style = SemiLight
font-size = 13

# Scrollback (~100 MiB; wezterm had 100k lines)
scrollback-limit = 104857600
mouse-scroll-multiplier = 5

# Mouse: ordinary terminal behaviour, no mode toggle.
#   * Apps that ask for the mouse (claude, yazi, mc, btop, anything over ssh)
#     get it: click, wheel and drag go to the app.
#   * Shift+drag / Shift+double-click is always a terminal selection, even
#     inside those apps; `never` stops an app from claiming Shift via
#     XTSHIFTESCAPE. Shift+middle-click pastes PRIMARY there too.
#   * Selecting fills both PRIMARY and CLIPBOARD on purpose: one predictable
#     clipboard, middle-click and Meta+V paste the same thing (matches
#     Claude Code's own copy-on-select). Meta+C is only needed elsewhere.
copy-on-select = clipboard
mouse-shift-capture = never
mouse-hide-while-typing = true
app-notifications = no-clipboard-copy


cursor-style = block
cursor-style-blink = false
# no-cursor: keep our own cursor styling. ssh-env + ssh-terminfo: fix
# "unknown terminal type" on remote hosts — Ghostty installs its terminfo over
# SSH (tic) and falls back to TERM=xterm-256color when that's not possible.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
theme = TokyoNight Moon

# Window
background-opacity = 1.0
confirm-close-surface = false
window-theme = dark

# Clipboard keys, sent by Sway via wtype:
#   Meta+C -> Ctrl+Insert   copy (Ghostty default binding)
#   Meta+X -> Shift+Delete  a terminal has nothing to cut, so it copies;
#                           `performable:` passes it on to the app (mcedit
#                           cut) when nothing is selected
#   Meta+V -> Shift+Insert  paste
keybind = performable:shift+delete=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard
keybind = performable:up=navigate_search:next
keybind = performable:down=navigate_search:previous

# Hard escape hatch when a crashed TUI left the terminal in a broken input mode
# (mouse reports flooding the prompt, Ctrl+C/Ctrl+D coming through as escape
# codes) and the prompt is too noisy to even type in. Same key as kitty's.
# The zsh precmd hook in ~/.zshrc normally clears this on the next prompt.
keybind = ctrl+shift+delete=reset
