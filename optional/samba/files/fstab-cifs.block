# CIFS/Samba network shares on the 192.168.1.11 NAS.
# Passwords are NOT stored here: each mount reads /etc/cifs-credentials/*.cred
# (deployed root-only by setup.sh). The actual passwords live in Bitwarden
# (search "NAS 192.168.1.11", user "sadmin").
# uid/gid are hardcoded to 1000 (primary desktop user) — adjust if you deploy
# this for a different account.
//192.168.1.11/share     /media/nas             cifs  credentials=/etc/cifs-credentials/nas.cred,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,forceuid,forcegid,iocharset=utf8,nofail,_netdev,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30,vers=3.0  0  0
//192.168.1.11/disk1     /media/disks/disk1     cifs  credentials=/etc/cifs-credentials/nas.cred,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,forceuid,forcegid,iocharset=utf8,nofail,_netdev,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30,vers=3.0  0  0
//192.168.1.11/disk2     /media/disks/disk2     cifs  credentials=/etc/cifs-credentials/nas.cred,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,forceuid,forcegid,iocharset=utf8,nofail,_netdev,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30,vers=3.0  0  0
//192.168.1.11/disk3     /media/disks/disk3     cifs  credentials=/etc/cifs-credentials/nas.cred,uid=1000,gid=1000,file_mode=0664,dir_mode=0775,forceuid,forcegid,iocharset=utf8,nofail,_netdev,x-systemd.automount,x-systemd.requires=network-online.target,x-systemd.idle-timeout=60,x-systemd.mount-timeout=30,vers=3.0  0  0
