# Tajemství mimo repo — hesla, tokeny, klíče, které install.sh nenasadí.
# Obsah sem nikdy nepatří, jen cesta a k čemu to je. Pracuje s tím ./secrets.sh:
#   ./secrets.sh status        co z toho na tomhle stroji je / chybí
#   ./secrets.sh pull <host>   doplní chybějící `copy` položky z jiného stroje (nic nepřepíše)
#   ./secrets.sh scan          najde soubory podobné tajemstvím, které tu ještě nejsou
#
# Formát řádku:  <režim>  <cesta>  <popis>
#   copy    přenáší se mezi stroji (pull)
#   local   patří jen jednomu stroji — nekopírovat; popis říká, jak to vytvořit znovu
#   ignore  scan to hlásí, ale tajemství to není (umlčení šumu)
# Cesta: ~/… nebo absolutní /etc/… (to jde přes sudo), bez mezer. Adresář = celý obsah.
#
# Seznam udržovat živý: kdo přidá step/optional/skript/projekt, který čte heslo
# mimo repo, přidá sem řádek. `./secrets.sh scan` ukáže, co se sem zapomnělo.

# --- Git, GPG ---
copy    ~/.gnupg                                   GPG klíč pro git-secret v ~/projects/passwords (pull kopíruje jen privátní klíče + import veřejných a ownertrust)
copy    ~/.gitconfig.d/custom                      git identita (user.name/email), include z config/git/gitconfig
copy    ~/.config/glab-cli/config.yml              GitLab CLI token (glab auth login)

# --- Kalendář (step 25) ---
copy    ~/.config/vdirsyncer/.client_id            Google OAuth client id pro vdirsyncer
copy    ~/.config/vdirsyncer/.client_secret        Google OAuth client secret pro vdirsyncer
copy    ~/.config/vdirsyncer/google_calendar_token OAuth token kalendáře (bez něj: vdirsyncer discover → přihlášení v prohlížeči)

# --- Vývoj, cloud, registry (práce) ---
copy    ~/.azure                                   Azure CLI login (az login)
copy    ~/.kube                                    kubeconfigy AKS
copy    ~/.docker/config.json                      docker registry login
copy    ~/.npmrc                                   npm registry token
copy    ~/.gradle/gradle.properties                Gradle přístupy (Artifactory)
copy    ~/.config/artifactory/token                Artifactory token
copy    ~/.netrc-masherbrum                        přístup pro masherbrum
copy    ~/.pgpass                                  PostgreSQL hesla
copy    ~/.grafana_token                           Grafana API token
copy    ~/.oracle-geo                              Oracle geo připojení
copy    ~/.config/mcp-secrets                      tokeny a loginy pro MCP servery (gitlab, jira, oracle)
copy    ~/.mcp-hub                                 mcp-hub: secrets.env + certifikáty
copy    ~/.local/share/opencode/auth.json          opencode login

# --- Tajemství uvnitř projektů (gitignored, git clone je nepřinese) ---
copy    ~/projects/makalu/gitlab-token.txt         GitLab token pro makalu skripty
copy    ~/projects/makalu/ui/.env.local            makalu UI lokální env
copy    ~/projects/makalu/scripts/pv-mssql/.env    makalu pv-mssql přístup
copy    ~/projects/team-pulse/.env                 team-pulse env
copy    ~/projects/garage-door-notif/include/secrets.h  Wi-Fi/MQTT hesla pro firmware garážových vrat
copy    ~/projects/AirportMap/app/airport-map-release-key.jks  Android release keystore — bez něj nejde vydat update aplikace!
copy    ~/projects/genealogy-tools/infra/gramps-web/.env  Gramps Web env (zálohuje i optional/zaloha-genealogie)

# --- VPN ---
copy    ~/work/cetin/vpn                           CETIN VPN (openconnect, scripts/vpn-cetin.sh): klientský cert + klíč + CA; na zdroji symlink na YYYY_MM_vpn, pull ho rozbalí jako adresář; cert platí do 2028-05-18
local   /etc/NetworkManager/system-connections/home-full.nmconnection   WireGuard domů (scripts/vpn-home.sh) — vlastní peer na stroj, nekopírovat z jiného stroje: konfigurace je na NASu server:~/projects/home_network/vpn/<stroj>-wg.secret (notebook 10.10.0.3, work-desktop .4, t470s .5) → vpn-home.sh setup <soubor>
local   /etc/NetworkManager/system-connections/home-split.nmconnection  WireGuard domů, split tunel — vzniká spolu s home-full (vpn-home.sh setup)
copy    ~/private/openvpn                          starší OpenVPN profily domů (skybit.cz), předchůdce WireGuardu
copy    ~/private/vpn                              starší VPN certifikát + klíč (2023)

# --- Osobní hesla ---
copy    ~/private/passwords.txt                    hesla (textový soubor)
copy    ~/private/otp.txt                          OTP / záložní kódy
copy    ~/private/gis_tu_crisp.env                 přístupy GIS TU CRISP
copy    ~/private/vivaldi.key                      záloha šifrovacího klíče Vivaldi Sync

# --- Optional komponenty ---
copy    ~/.config/rclone/rclone.conf               rclone remotes (optional/dropbox, optional/onedrive); timer pouštět jen na jednom stroji
copy    /etc/cetin-printer.cred                    AD heslo pro tiskárnu CETIN (optional/printer-cetin)
copy    /etc/cifs-credentials                      hesla k NAS sdílením (optional/samba), záloha v Bitwardenu "NAS 192.168.1.11"
local   ~/.config/strava/credentials.json          Strava OAuth (optional/strava) — refresh token rotuje, smí ho mít jen stroj s timerem; nově viz hlavička strava-cleanup.py

# --- Jen pro jeden stroj (vytvořit znovu, nekopírovat) ---
local   ~/.ssh/id_ed25519                          vlastní klíč každého stroje: ssh-keygen -t ed25519 + ssh-copy-id server / desktop
local   ~/.claude/.credentials.json                Claude Code login: claude → /login
local   ~/.purple                                  WhatsApp (purple-whatsmeow) session — zařízení se páruje znovu
local   ~/.local/share/keyrings                    GNOME keyring šifrovaný loginem — aplikace se přihlásí znovu

# --- Šum pro scan ---
ignore  ~/.claude/sessions                         interní klíče běžících Claude sessions
ignore  ~/.claude/daemon                           interní klíč Claude daemonu
ignore  ~/.docker/.token_seed                      docker CLI interní
ignore  ~/.docker/.token_seed.lock                 docker CLI interní
ignore  ~/.emulator_console_auth_token             Android emulátor, vytvoří se sám
ignore  ~/.config/go/telemetry                     Go telemetrie
ignore  ~/.local/share/vitest                      vitest interní
ignore  ~/.config/joplin-desktop                   Joplin interní (sync login je v aplikaci)
ignore  ~/.config/ghostty/themes                   barevná schémata "Token Dark/Light"
ignore  ~/.claude/plugins                          .npmrc z marketplace pluginů, žádné tokeny
ignore  ~/vivaldi.key                               ruční kopie ~/private/vivaldi.key (stejný soubor)
